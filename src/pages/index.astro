---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('writing', ({ data }) => import.meta.env.DEV || !data.draft);
const posts = all
  .filter((p) => !p.data.unlisted)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
// The same post in another language, shown as a second title on the entry.
const translationOf = (p: (typeof all)[number]) => all.find((o) => o.id === p.data.translation);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<Base>
  {posts.length === 0 && <p class="meta">Nothing here yet.</p>}
  <ul class="post-list">
    {
      posts.map((p) => {
        const other = translationOf(p);
        return (
          <li lang={p.data.lang}>
            <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
            <a class="title" href={`/writing/${p.id}/`}>{p.data.title}</a>
            {other && (
              <a class="title alt" href={`/writing/${other.id}/`} lang={other.data.lang} hreflang={other.data.lang}>
                {other.data.title}
                <span class="tag">中文版</span>
              </a>
            )}
            {p.data.description && <div class="desc">{p.data.description}</div>}
          </li>
        );
      })
    }
  </ul>
</Base>
